declare thread_data_t as a record of
    thread_number as integer
    start as integer
    finish as integer
end record

procedure brute_force(zippass, zip_path, thread_count) do
// Begin assuming the brute force hasn't been successful yet
declare copies := create_copies(zip_path, thread_count)

#parallel(thread_count)
{
    declare my_copy := copies[thread_number] 
    zip_open(my_copy)
    # for collapse(2)
    for i := 0 to passwords_max_length do
        current_length := i+1
        declare count := power(alphabet_length, current_length)
        for j := 0 to count do
            declare password := generate_password(j)
            if zip_fopen(password) then
                #critical
                return password
            end if

        end  for
    end for
}

    
end procedure

procedure brute_force() do

end procedure

procedure create_copies(zip_path, thread_count) do
    declare copies as an array of strings of size thread_count

    for i := 0 to thread_count do
        declare new_zip_path := "temp/" + i + filename(zip_path)
        create_temporal_file(zip_path, new_path)
        copies[i] := new_zip_path
    end for
    return copies
end procedure

procedure delete_copies() do
    for i := 0 to thread_count do
        declare new_zip_path := "temp/" + i + filename(zip_path)
        remove_temporal_file(zip_path, new_path)
    end for
end procedure

procedure get_password(index, length, alphabet) do
    declare base := length(alphabet)
    declare password := ""
    declare alphabet_index := 0

    for i := 0 to length do
        alphabet_index := index mod base
        password[i] := alphabet[alphabet_index]
        index := index / base
    end

    return password
end procedure


