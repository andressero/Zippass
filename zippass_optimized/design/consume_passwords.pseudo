

-

    declare private_data as a record of
        my_thread_number as integer
        my_zip_path as string
        my_passwords_file as string
        password_return as string
        zippass as zippass
    end record

    procedure consume_passwords(private_data) do
        declare my_zip := zip_open(my_zip_path)
        declare password as empty string
        declare password_found := false

        while !password_found do
            declare block := dequeue()

            if is_empty(block) do
                break
            end

            for block.start to block.finish do
                password := generate_password(block.password_length)
                if zip_fopen(password) == open do
                    password_return = password
                    lock(can_access_status)
                    brute_forced = true
                    unlock(can_access_status)                   
                end

                lock(can_access_status)
                password_found = brute_forced
                unlock(can_access_status)
            end

        end while

        while !brute_forced do


            
            if zip_fopen(password) =0 open then
                password_return = password
                lock(can_access_status)
                brute_forced = true
                unlock(can_access_status)
            end if
            lock(can_access_status)
            brute_forced = zippass->brute_forced
            unlock(can_access_status)
        end while

    end procedure
-