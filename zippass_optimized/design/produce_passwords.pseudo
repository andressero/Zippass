-

    procedure produce_passwords(alphabet, passwords_max_length) do
        for i := 0 to passwords_max_length do
            declare current_length := i+1
            declare count := power(length(alphabet), current_length)
            declare block as block_t
            if count > thread_count do
                for thread_number := 0 to thread_count do
                    block.start := map(thread_number, count,thread_count)
                    block.finish := map(thread_number + 1, count,thread_count) - 1
                    block.password_length := current_length
                    enqueue(block)
                end
            else
                block.start := 0
                block.finish := count
                bloc.password_length := current_length
            end
        end
    end

-