-
    procedure consume_passwords(zip_copy) do

        declare zip_t := zip_open(zip_copy)
        while true do
            wait(can_consume)
            if is_empty(queue) do
                break while
            else 
                declare my_password := dequeue(queue)
                if zip_fopen(password) == OPEN do
                    return password
                end if
            end if
        end while

    end procedure
-