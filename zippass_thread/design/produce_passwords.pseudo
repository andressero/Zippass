-

    procedure produce_passwords(alphabet, passwords_max_length) do
        declare password := ""
        for i := 0 to passwords_max_length do
            declare count := power(length(alphabet), i+1)
            for j:= 0 to count do
                password := get_password(j, i, alphabet)
                enqueue(password)
            end for
        end for
    end procedure

-